{
  "name": "Taskible Design System Tokens",
  "version": "1.0.0",
  "typography": {
    "fontFamilies": {
      "sans": "Manrope, sans-serif",
      "serif": "\"Playfair Display\", Georgia, serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "scale": {
      "h1": {
        "desktop": { "fontSize": "64px", "lineHeight": "70.4px", "letterSpacing": "-1.92px", "fontWeight": "600" },
        "tablet": { "fontSize": "48px", "lineHeight": "52.8px", "letterSpacing": "-1.44px", "fontWeight": "600" },
        "mobile": { "fontSize": "36px", "lineHeight": "41.4px", "letterSpacing": "-1.08px", "fontWeight": "600" }
      },
      "h2": {
        "desktop": { "fontSize": "48px", "lineHeight": "52.8px", "letterSpacing": "-1.44px", "fontWeight": "600" },
        "tablet": { "fontSize": "36px", "lineHeight": "41.4px", "letterSpacing": "-1.08px", "fontWeight": "600" },
        "mobile": { "fontSize": "28px", "lineHeight": "33.6px", "letterSpacing": "-0.84px", "fontWeight": "600" }
      },
      "h3": {
        "desktop": { "fontSize": "32px", "lineHeight": "35.2px", "letterSpacing": "-0.96px", "fontWeight": "600" },
        "mobile": { "fontSize": "24px", "lineHeight": "28.8px", "letterSpacing": "-0.72px", "fontWeight": "600" }
      },
      "h4": {
        "desktop": { "fontSize": "24px", "lineHeight": "26.4px", "letterSpacing": "-0.72px", "fontWeight": "600" },
        "mobile": { "fontSize": "20px", "lineHeight": "24px", "letterSpacing": "-0.6px", "fontWeight": "600" }
      },
      "h5": {
        "fontSize": "20px",
        "lineHeight": "22px",
        "letterSpacing": "-0.6px",
        "fontWeight": "600"
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "25.6px",
        "fontWeight": "400"
      },
      "eyebrow": {
        "fontSize": "13px",
        "lineHeight": "16px",
        "letterSpacing": "0.06em",
        "fontWeight": "700",
        "textTransform": "uppercase"
      },
      "button": {
        "fontSize": "15px",
        "lineHeight": "20px",
        "letterSpacing": "-0.15px",
        "fontWeight": "600"
      }
    },
    "highlight": {
      "fontFamily": "\"Playfair Display\", serif",
      "fontStyle": "italic",
      "fontWeight": "600",
      "color": "#0066FF"
    }
  },
  "colors": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F8FBFF",
      "surfaceMuted": "#F2F8FF",
      "surfaceAlt": "#E5EFFF",
      "textPrimary": "#001A41",
      "textSecondary": "#475569",
      "textMuted": "#8093B1",
      "border": "#E5EFFF",
      "borderAccent": "rgba(0, 102, 255, 0.2)",
      "primary": "#0066FF",
      "primaryHover": "#0052CC",
      "primaryForeground": "#FFFFFF"
    },
    "dark": {
      "background": "#001A41",
      "surface": "#050F26",
      "surfaceMuted": "#0A1738",
      "surfaceAlt": "#10234E",
      "textPrimary": "#F8FBFF",
      "textSecondary": "#A3ACBA",
      "textMuted": "#8093B1",
      "border": "rgba(255, 255, 255, 0.1)",
      "borderAccent": "rgba(0, 102, 255, 0.4)",
      "primary": "#0066FF",
      "primaryHover": "#297FFF",
      "primaryForeground": "#FFFFFF"
    },
    "accents": {
      "blue": "#0066FF",
      "cyan": "#00D2FF",
      "emerald": "#10B981",
      "amber": "#F59E0B",
      "rose": "#F43F5E"
    },
    "gradients": {
      "buttonPrimary": "linear-gradient(135deg, #0066FF 0%, #297FFF 100%)",
      "heroRadial": "radial-gradient(50% 50% at 50% 50%, rgba(0, 102, 255, 0.15) 0%, rgba(255, 255, 255, 0) 100%)",
      "cardHighlight": "linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(248, 251, 255, 0.4) 100%)",
      "specularBorder": "linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.4) 50%, transparent 100%)"
    }
  },
  "layout": {
    "containerMaxWidth": "1300px",
    "innerContentMaxWidth": "1220px",
    "sectionPaddingY": "80px",
    "sectionPaddingX": {
      "desktop": "40px",
      "tablet": "24px",
      "mobile": "16px"
    },
    "gridGap": "24px"
  },
  "radii": {
    "card": "24px",
    "pill": "9999px",
    "squircle": "16px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px"
  },
  "shadows": {
    "button": "0px 0px 0px 1px #0063FB, 0px 0.5px 0.5px 0px rgba(69, 144, 178, 0.25) inset, 0px -6px 12px 0px rgba(255, 255, 255, 0.1) inset",
    "buttonHover": "0 10px 24px -6px rgba(0, 102, 255, 0.4), 0px 0px 0px 1px #0063FB",
    "card": "0 10px 30px -10px rgba(0, 26, 65, 0.05), 0 0 1px 1px rgba(0, 26, 65, 0.05)",
    "cardElevated": "0 20px 40px -15px rgba(0, 26, 65, 0.1), 0 0 30px -5px rgba(0, 102, 255, 0.15)"
  },
  "breakpoints": {
    "desktop": "1440px",
    "laptop": "1024px",
    "tablet": "768px",
    "mobile": "390px"
  },
  "motion": {
    "durationDefault": "0.3s",
    "durationSlow": "0.5s",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "hoverLift": "translateY(-4px)"
  }
}
