{
  "name": "ShipLane",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('apps/dashboard/.next', {recursive:true, force:true}); console.log('Cleaned .next cache');\"",
    "dev": "npm run dev --workspace=apps/dashboard",
    "build": "npm run build --workspace=apps/dashboard",
    "infra:up": "cd infra && docker compose up -d",
    "infra:down": "cd infra && docker compose down",
    "db:push": "npm run db:push --workspace=apps/dashboard",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:generate": "npm run db:generate --workspace=apps/dashboard",
    "db:studio": "npm run db:studio --workspace=apps/dashboard",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:workers": "npx tsx apps/workers/builder.ts",
    "test:e2e": "npx tsx scripts/e2e-test.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.6": true
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1"
  }
}
